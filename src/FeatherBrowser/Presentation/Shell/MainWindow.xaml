<Window
    x:Class="FeatherBrowser.Presentation.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Feather"
    Icon="/Assets/Branding/feather.ico"
    Width="1360"
    Height="860"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    BorderThickness="0"
    Background="{DynamicResource ChromeBrush}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    KeyDown="Window_KeyDown"
    StateChanged="Window_StateChanged"
    Closing="Window_Closing"
    FontFamily="{StaticResource UiFont}"
    FontSize="12"
    Foreground="{DynamicResource TextPrimaryBrush}"
    TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="34"
            ResizeBorderThickness="5"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <DockPanel x:Name="RootPanel" LastChildFill="True">
        <Border
            x:Name="TitleBar"
            DockPanel.Dock="Top"
            Height="34"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="180" MaxWidth="520" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Toolbar" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                    <Button x:Name="BackButton" Style="{StaticResource ToolbarButton}" Content="&#xE72B;"
                            ToolTip="Back (Alt+Left)" Click="BackButton_Click" AutomationProperties.Name="Back" />
                    <Button x:Name="ForwardNavButton" Style="{StaticResource ToolbarButton}" Content="&#xE72A;"
                            ToolTip="Forward (Alt+Right)" Click="ForwardButton_Click" AutomationProperties.Name="Forward" />
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolbarButton}" Content="&#xE72C;"
                            ToolTip="Reload (Ctrl+R)" Click="ReloadButton_Click" AutomationProperties.Name="Reload" />
                </StackPanel>

                <Border
                    x:Name="AddressBorder"
                    Grid.Column="1"
                    Height="26"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource FieldBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SiteButton" Grid.Column="0" Style="{StaticResource IconButton}" Width="26" Height="24" Margin="1,0,0,0"
                                ToolTip="Site information" Click="SiteButton_Click" AutomationProperties.Name="Site information">
                            <Grid>
                                <TextBlock x:Name="AddressSearchIcon" Text="&#xE721;" FontSize="11" />
                                <TextBlock x:Name="AddressLockIcon" Text="&#xE72E;" FontSize="11" Visibility="Collapsed" />
                                <TextBlock x:Name="AddressWarningIcon" Text="&#xE7BA;" FontSize="11" Visibility="Collapsed"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <Path x:Name="AddressFeatherIcon" Visibility="Collapsed" Fill="{DynamicResource AccentBrush}" Stretch="Uniform"
                                      Width="9" Height="11" Data="M 4,35 C 5,13 16,4 32,0 C 28,21 21,29 8,29 L 0,40 L 17,17 Z" />
                            </Grid>
                        </Button>
                        <Grid Grid.Column="1" Margin="2,0,0,0">
                            <TextBlock x:Name="AddressPlaceholder" Text="Search or enter address" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="AddressBox" Style="{StaticResource InlineTextBox}" Padding="0,0,4,0"
                                     TextChanged="AddressBox_TextChanged" KeyDown="AddressBox_KeyDown"
                                     GotKeyboardFocus="AddressBox_GotKeyboardFocus" LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                                     AutomationProperties.Name="Search or enter address" />
                        </Grid>
                        <Button x:Name="BookmarkButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="24" Margin="0,0,1,0"
                                ToolTip="Add to favorites (Ctrl+D)" Click="BookmarkButton_Click" AutomationProperties.Name="Add to favorites">
                            <TextBlock x:Name="BookmarkIcon" Text="&#xE734;" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="TabBar" Grid.Column="2" Padding="6,0,0,0" ClipToBounds="True" SizeChanged="TabBar_SizeChanged">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        </ScrollViewer>
                        <Button x:Name="NewTabButton" Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="&#xE710;" Margin="2,0,0,0"
                                HorizontalAlignment="Left" ToolTip="New tab (Ctrl+T)" Click="NewTabButton_Click" AutomationProperties.Name="New tab" />
                    </Grid>
                </Border>
                <TextBlock x:Name="TitleText" Visibility="Collapsed" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                    <Button x:Name="ShieldButton" Style="{StaticResource ToolbarButton}" Content="&#xEA18;"
                            ToolTip="Feather Shield" Click="ShieldButton_Click" AutomationProperties.Name="Feather Shield" />
                    <Button x:Name="DownloadsButton" Style="{StaticResource ToolbarButton}" Content="&#xE896;" Tag="downloads"
                            ToolTip="Downloads (Ctrl+J)" Click="SidebarQuickButton_Click" AutomationProperties.Name="Downloads" />
                    <Button x:Name="MenuButton" Style="{StaticResource ToolbarButton}" Content="&#xE712;"
                            ToolTip="Menu" Click="MenuButton_Click" AutomationProperties.Name="Menu" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeButton_Click"
                            ToolTip="Maximize" AutomationProperties.Name="Maximize or restore" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click"
                            ToolTip="Close" AutomationProperties.Name="Close window" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar
            x:Name="NavigationProgress"
            DockPanel.Dock="Top"
            Style="{StaticResource ThinProgressBar}"
            Height="2"
            Margin="0,-2,0,0"
            Panel.ZIndex="5"
            Minimum="0"
            Maximum="1"
            Value="0"
            Visibility="Collapsed"
            AutomationProperties.Name="Page loading" />

        <Border
            x:Name="WorkspaceSidebar"
            DockPanel.Dock="Left"
            Width="196"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0"
            Padding="6,8,6,6">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="8,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Workspaces" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="WorkspaceHintText" Text="Cold when inactive" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" Width="24" Height="24" FontSize="10"
                            ToolTip="New workspace" Click="AddWorkspaceButton_Click" AutomationProperties.Name="New workspace" />
                </Grid>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="2,4,2,4" />
                    <Button Style="{StaticResource SidebarButton}" Click="HomeButton_Click" AutomationProperties.Name="New tab page">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" /><TextBlock Text="New tab page" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Tag="favorites" Click="SidebarQuickButton_Click" AutomationProperties.Name="Favorites">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE728;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" /><TextBlock Text="Favorites" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Tag="history" Click="SidebarQuickButton_Click" AutomationProperties.Name="History">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" /><TextBlock Text="History" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Tag="downloads" Click="SidebarQuickButton_Click" AutomationProperties.Name="Downloads">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" /><TextBlock Text="Downloads" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Tag="settings" Click="SidebarQuickButton_Click" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" /><TextBlock Text="Settings" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Tag="trim" Click="SidebarQuickButton_Click" AutomationProperties.Name="Free memory">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" /><TextBlock Text="Free memory" /></StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer Style="{StaticResource SlimScrollViewer}">
                    <StackPanel x:Name="WorkspaceButtonsPanel" AutomationProperties.Name="Workspaces" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel LastChildFill="True">
            <Border
                x:Name="SaveLoginBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Height="36"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0,6,0"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="Save password">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SaveLoginText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="SaveLoginDetail" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="Never for this site" Margin="0,0,6,0"
                                Click="SaveLoginNeverButton_Click" AutomationProperties.Name="Never save passwords for this site" />
                        <Button x:Name="SaveLoginButton" Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,4,0"
                                Click="SaveLoginButton_Click" AutomationProperties.Name="Save password" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" ToolTip="Not now"
                                Click="SaveLoginDismissButton_Click" AutomationProperties.Name="Not now" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="PermissionBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Height="36"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0,6,0"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="Site permission request">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PermissionIcon" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PermissionText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="PermissionDetail" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PermissionBlockButton" Style="{StaticResource SecondaryButton}" Content="Block" Margin="0,0,6,0"
                                Click="PermissionBlockButton_Click" AutomationProperties.Name="Block" />
                        <Button x:Name="PermissionAllowButton" Style="{StaticResource PrimaryButton}" Content="Allow" Margin="0,0,4,0"
                                Click="PermissionAllowButton_Click" AutomationProperties.Name="Allow" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" ToolTip="Not now"
                                Click="PermissionDismissButton_Click" AutomationProperties.Name="Not now" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="FindBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Height="34"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,0,6,0">
                <Border HorizontalAlignment="Right" Width="320" Height="26" Background="{DynamicResource FieldBrush}"
                        BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindBox" Style="{StaticResource InlineTextBox}" Padding="8,0,4,0"
                                 TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" AutomationProperties.Name="Find on page" />
                        <TextBlock x:Name="FindCount" Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0,6,0" />
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70E;" Width="24" Height="22" FontSize="10"
                                ToolTip="Previous match (Shift+Enter)" Click="FindPreviousButton_Click" AutomationProperties.Name="Previous match" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE70D;" Width="24" Height="22" FontSize="10"
                                ToolTip="Next match (Enter)" Click="FindNextButton_Click" AutomationProperties.Name="Next match" />
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="22" FontSize="10" Margin="0,0,1,0"
                                ToolTip="Close (Esc)" Click="FindCloseButton_Click" AutomationProperties.Name="Close find bar" />
                    </Grid>
                </Border>
            </Border>

            <Grid x:Name="BrowserHost" Background="{DynamicResource ContentBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SplitLeftColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitDividerColumn" Width="0" />
                    <ColumnDefinition x:Name="SplitRightColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <GridSplitter
                    x:Name="SplitDivider"
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Background="{DynamicResource DividerBrush}"
                    Visibility="Collapsed"
                    Cursor="SizeWE"
                    AutomationProperties.Name="Resize split view" />
                <Border x:Name="LoadingOverlay" Grid.ColumnSpan="3" Background="{DynamicResource ContentBrush}" Visibility="Visible" Panel.ZIndex="90" />
                <Grid
                    x:Name="CommandPaletteOverlay"
                    Grid.ColumnSpan="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource ScrimBrush}"
                    Panel.ZIndex="100"
                    MouseDown="CommandPaletteOverlay_MouseDown"
                    KeyboardNavigation.TabNavigation="Cycle"
                    FocusManager.IsFocusScope="True">
                    <Border
                        VerticalAlignment="Top"
                        Margin="16,12,16,16"
                        Background="{DynamicResource MenuBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6"
                        MaxWidth="620"
                        MaxHeight="480">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Height="32" Margin="0,0,0,6" Background="{DynamicResource FieldBrush}"
                                    BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,8,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="CommandPaletteBox" Grid.Column="1" Style="{StaticResource InlineTextBox}" FontSize="13" Padding="0,0,10,0"
                                             TextChanged="CommandPaletteBox_TextChanged" KeyDown="CommandPaletteBox_KeyDown"
                                             AutomationProperties.Name="Search tabs, history, favorites and commands" />
                                </Grid>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Margin="8,6,8,2" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5"
                                       Text="Enter to run · ↑↓ to move · Esc to close" />
                            <ListBox x:Name="CommandPaletteList" Style="{StaticResource CommandList}"
                                     MouseDoubleClick="CommandPaletteList_MouseDoubleClick" AutomationProperties.Name="Commands and search results" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
