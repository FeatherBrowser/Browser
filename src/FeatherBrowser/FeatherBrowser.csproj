<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FeatherBrowser</AssemblyName>
    <RootNamespace>FeatherBrowser</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>Feather Browser</Product>
    <Description>A Windows browser with workspace and background-tab resource controls.</Description>
    <ApplicationIcon>Assets\Branding\feather.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Branding\feather.ico;Assets\Branding\feather.png" />
    <EmbeddedResource Include="Assets\Pages\*;Assets\Scripts\*">
      <LogicalName>FeatherBrowser.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Assets\Pages\feather.svg" />
  </ItemGroup>
</Project>
