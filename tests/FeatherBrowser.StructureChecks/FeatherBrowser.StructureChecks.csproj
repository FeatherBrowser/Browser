<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
  <ProjectReference Include="..\..\external\FeatherShield\src\FeatherShield\FeatherShield.csproj" />
</ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/FeatherBrowser/Infrastructure/Resources/AppInfo.cs" Link="AppInfo.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/WebView3/*.cs" Link="WebView3/%(Filename)%(Extension)" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/BrowserSettings.cs" Link="BrowserSettings.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/QuickLink.cs" Link="QuickLink.cs" />
    <Compile Include="../../src/FeatherBrowser/Presentation/Pages/StartPage.cs" Link="StartPage.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/Navigation/AddressResolver.cs" Link="AddressResolver.cs" />
    <Compile Include="../../src/FeatherBrowser/Infrastructure/Resources/EmbeddedAssets.cs" Link="EmbeddedAssets.cs" />
    <EmbeddedResource Include="../../src/FeatherBrowser/Assets/Pages/*;../../src/FeatherBrowser/Assets/Scripts/*">
      <LogicalName>FeatherBrowser.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
