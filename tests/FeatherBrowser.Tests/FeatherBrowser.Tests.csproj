    <Compile Include="../../src/FeatherBrowser/Domain/Models/UrlIdentity.cs" Link="UrlIdentity.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/DeviceTabs.cs" Link="DeviceTabs.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/BrowserBookmark.cs" Link="BrowserBookmark.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/HistoryEntry.cs" Link="HistoryEntry.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/DownloadEntry.cs" Link="DownloadEntry.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/SessionState.cs" Link="SessionState.cs" />
