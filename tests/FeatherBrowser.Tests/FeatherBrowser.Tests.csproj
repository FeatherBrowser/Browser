    <PackageReference Include="coverlet.collector" Version="6.0.2" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/FeatherBrowser/Infrastructure/Resources/AppInfo.cs" Link="AppInfo.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/WebView3/*.cs" Link="WebView3/%(Filename)%(Extension)" />
    <Compile Include="../../src/FeatherBrowser/Features/Security/InternalPageMessagePolicy.cs" Link="Security/InternalPageMessagePolicy.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/Security/SitePermissionPolicy.cs" Link="Security/SitePermissionPolicy.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/BrowserSettings.cs" Link="BrowserSettings.cs" />
    <Compile Include="../../src/FeatherBrowser/Domain/Models/QuickLink.cs" Link="QuickLink.cs" />
    <Compile Include="../../src/FeatherBrowser/Presentation/Pages/StartPage.cs" Link="StartPage.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/Navigation/AddressResolver.cs" Link="AddressResolver.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/Engine/EngineProcesses.cs" Link="Engine/EngineProcesses.cs" />
    <Compile Include="../../src/FeatherBrowser/Features/Engine/DownloadPaths.cs" Link="Engine/DownloadPaths.cs" />
